{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,

    "types": ["node"],
    "sourceMap": true
  },

  "include": [
    "src/**/*.ts",
    "generated/**/*.ts",
    "prisma/seed.ts",
    "prisma7.config.ts",
    "tests/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}

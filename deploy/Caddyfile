# Replace salon.example.com with the selected public DNS name.
salon.example.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:3000
    }
    handle {
        root * /opt/salon/current/frontend/dist
        route {
            try_files {path} /index.html
            header Cache-Control "no-cache"
            file_server
        }
    }
}

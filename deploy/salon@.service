[Unit]
Description=Salon %i process
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=salon
Group=salon
WorkingDirectory=/opt/salon/current/backend
EnvironmentFile=/etc/salon/salon.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/salon/current/backend/dist/src/%i.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
